# Configuración general de la aplicación
APP_NAME=Tradux
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Configuración del servidor HTTP
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Puerto host para Docker (por defecto 8008 para evitar conflictos)
TRADUX_PORT=8008

# Almacenamiento local temporal y salida
TEMP_DIR=temp
OUTPUT_DIR=output
MAX_UPLOAD_SIZE_MB=50
